{
  "name": "@toolmark/react",
  "version": "0.1.0-next.3",
  "description": "React bindings for Toolmark: provider, hooks, scopes, form tools and the react-hook-form adapter.",
  "keywords": [
    "toolmark",
    "ai",
    "agents",
    "llm",
    "tools",
    "react",
    "hooks",
    "react-hook-form"
  ],
  "homepage": "https://github.com/adams100111/toolmark/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/adams100111/toolmark/issues"
  },
  "license": "MIT",
  "author": "adams100111",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adams100111/toolmark.git",
    "directory": "packages/react"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "@toolmark/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rhf": {
      "@toolmark/source": "./src/rhf/index.ts",
      "types": "./dist/rhf/index.d.ts",
      "import": "./dist/rhf/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "@toolmark/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.3.0 <20",
    "react-hook-form": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "react-hook-form": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "zod": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
