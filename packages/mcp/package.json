{
  "name": "@toolmark/mcp",
  "version": "0.1.0-next.3",
  "description": "Desktop MCP server (stdio) that exposes a paired Toolmark page's tools",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adams100111/toolmark.git",
    "directory": "packages/mcp"
  },
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "src"
  ],
  "bin": {
    "toolmark-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "@toolmark/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "@toolmark/source": "./src/client/index.ts",
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.1.0",
    "@toolmark/core": "workspace:*",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "catalog:",
    "@toolmark/testing": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "8.18.1"
  }
}
