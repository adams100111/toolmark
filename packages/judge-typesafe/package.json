{
  "name": "@toolmark/judge-typesafe",
  "version": "1.0.0",
  "description": "Optional TypeSafe judge plugin for @toolmark/lint: Node-only probabilistic checks for description quality, tool overlap and consequential-hint coverage.",
  "keywords": [
    "toolmark",
    "ai",
    "agents",
    "llm",
    "tools",
    "lint",
    "typesafe",
    "judge"
  ],
  "homepage": "https://github.com/adams100111/toolmark/tree/main/packages/judge-typesafe#readme",
  "bugs": {
    "url": "https://github.com/adams100111/toolmark/issues"
  },
  "license": "MIT",
  "author": "adams100111",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adams100111/toolmark.git",
    "directory": "packages/judge-typesafe"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "@toolmark/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0"
  },
  "peerDependencies": {
    "@toolmark/lint": "workspace:^"
  },
  "devDependencies": {
    "@toolmark/core": "workspace:*",
    "@toolmark/lint": "workspace:*",
    "@types/node": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
