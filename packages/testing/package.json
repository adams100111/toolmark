{
  "name": "@toolmark/testing",
  "version": "1.0.0",
  "description": "Testing helpers for Toolmark: a Vitest test registry and a Playwright fixture that drives page tools.",
  "keywords": [
    "toolmark",
    "ai",
    "agents",
    "llm",
    "tools",
    "testing",
    "playwright",
    "vitest"
  ],
  "homepage": "https://github.com/adams100111/toolmark/tree/main/packages/testing#readme",
  "bugs": {
    "url": "https://github.com/adams100111/toolmark/issues"
  },
  "license": "MIT",
  "author": "adams100111",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adams100111/toolmark.git",
    "directory": "packages/testing"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "@toolmark/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vitest": {
      "@toolmark/source": "./src/vitest.ts",
      "types": "./dist/vitest.d.ts",
      "import": "./dist/vitest.js"
    },
    "./page": {
      "@toolmark/source": "./src/page/install-test-hook.ts",
      "types": "./dist/page/install-test-hook.d.ts",
      "import": "./dist/page/install-test-hook.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "@toolmark/core": "workspace:*"
  },
  "peerDependencies": {
    "@playwright/test": "^1.63.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "vite": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
