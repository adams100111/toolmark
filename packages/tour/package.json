{
  "name": "@toolmark/tour",
  "version": "1.0.0-next.4",
  "description": "Framework-free guided tour engine over the registry's tools, anchors and interaction events, with a vanilla-DOM overlay and a React binding.",
  "keywords": [
    "toolmark",
    "ai",
    "agents",
    "llm",
    "tools",
    "tour",
    "onboarding",
    "guided-tour"
  ],
  "homepage": "https://github.com/adams100111/toolmark/tree/main/packages/tour#readme",
  "bugs": {
    "url": "https://github.com/adams100111/toolmark/issues"
  },
  "license": "MIT",
  "author": "adams100111",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adams100111/toolmark.git",
    "directory": "packages/tour"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "@toolmark/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./overlay": {
      "@toolmark/source": "./src/overlay/index.ts",
      "types": "./dist/overlay.d.ts",
      "import": "./dist/overlay.js"
    },
    "./react": {
      "@toolmark/source": "./src/react/index.ts",
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "@toolmark/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.3.0 <20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "axe-core": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
