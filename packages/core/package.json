{
  "name": "@toolmark/core",
  "version": "0.1.0-next.3",
  "description": "Framework-agnostic tool registry, policy, confirmation, form tools and bridge protocol for agent-operable web apps, with an experimental WebMCP adapter.",
  "keywords": [
    "toolmark",
    "ai",
    "agents",
    "llm",
    "tools",
    "webmcp",
    "mcp",
    "forms",
    "registry"
  ],
  "homepage": "https://github.com/adams100111/toolmark/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/adams100111/toolmark/issues"
  },
  "license": "MIT",
  "author": "adams100111",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adams100111/toolmark.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "@toolmark/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "@toolmark/source": "./src/protocol/index.ts",
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js"
    },
    "./protocol/v1/*.json": "./dist/protocol/v1/*.json",
    "./bridge": {
      "@toolmark/source": "./src/bridge/index.ts",
      "types": "./dist/bridge/index.d.ts",
      "import": "./dist/bridge/index.js"
    },
    "./bridge/echo": {
      "@toolmark/source": "./src/bridge/echo.ts",
      "types": "./dist/bridge/echo.d.ts",
      "import": "./dist/bridge/echo.js"
    },
    "./bridge/websocket": {
      "@toolmark/source": "./src/bridge/websocket.ts",
      "types": "./dist/bridge/websocket.d.ts",
      "import": "./dist/bridge/websocket.js"
    },
    "./bridge/post-message": {
      "@toolmark/source": "./src/bridge/post-message.ts",
      "types": "./dist/bridge/post-message.d.ts",
      "import": "./dist/bridge/post-message.js"
    },
    "./bridge/in-page": {
      "@toolmark/source": "./src/bridge/in-page.ts",
      "types": "./dist/bridge/in-page.d.ts",
      "import": "./dist/bridge/in-page.js"
    },
    "./dom": {
      "@toolmark/source": "./src/dom/index.ts",
      "types": "./dist/dom.d.ts",
      "import": "./dist/dom.js"
    },
    "./webmcp": {
      "@toolmark/source": "./src/webmcp/index.ts",
      "types": "./dist/webmcp.d.ts",
      "import": "./dist/webmcp.js"
    },
    "./otel": {
      "@toolmark/source": "./src/otel/index.ts",
      "types": "./dist/otel.d.ts",
      "import": "./dist/otel.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && tsx scripts/emit-protocol-schemas.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "@mcp-b/webmcp-polyfill": "^5.0.0",
    "@opentelemetry/api": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "@mcp-b/webmcp-polyfill": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mcp-b/webmcp-polyfill": "5.1.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsx": "catalog:",
    "webmcp-types": "0.1.9",
    "zod": "catalog:",
    "zod-to-json-schema": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
