root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[{compose,docker-compose}.{yml,yaml}]
indent_size = 4

# Frontend and docs follow the repository's Prettier style.
[*.{js,jsx,mjs,ts,tsx,css,md}]
indent_size = 2

[{package.json,tsconfig.json}]
indent_size = 2
